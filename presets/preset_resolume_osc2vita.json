    { "id": "stick_l_amp",      "source": "stick.left.x",  "enabled": true, "address": "/composition/layers/4/dashboard/link2", "typeTag": "f", "min": 0.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.05, "absolute": true, "mode": "continuous" },
