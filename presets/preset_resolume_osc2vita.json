    { "id": "btn_triangle", "source": "button.triangle", "enabled": true, "address": "/composition/layers/2/clips/4/connect",  "typeTag": "i", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_up",       "source": "button.up",       "enabled": true, "address": "/composition/layers/2/clips/5/connect",  "typeTag": "i", "min": 0.0, "max": 1.0, "mode": "onChange" },
