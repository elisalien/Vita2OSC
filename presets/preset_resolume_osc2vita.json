    { "id": "stick_r_density",  "source": "stick.right.y", "enabled": true, "address": "/composition/layers/5/dashboard/link3", "typeTag": "f", "min": 0.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.05, "absolute": true, "mode": "continuous" },

