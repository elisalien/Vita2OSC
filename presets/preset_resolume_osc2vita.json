    { "id": "accel_octaves",  "source": "motion.accel.x", "enabled": true, "address": "/composition/layers/3/dashboard/link4", "typeTag": "f", "min": 0.0, "max": 1.0, "smoothing": 0.15, "absolute": true, "mode": "continuous" },

    { "id": "touch_front_0_x", "source": "touch.front.0.x", "enabled": true, "address": "/composition/dashboard/link1", "typeTag": "f", "min": 0.0, "max": 1.0, "zeroOnRelease": true, "mode": "continuous" },
    { "id": "touch_front_0_y", "source": "touch.front.0.y", "enabled": true, "address": "/composition/dashboard/link2", "typeTag": "f", "min": 0.0, "max": 1.0, "invert": true, "zeroOnRelease": true, "mode": "continuous" },
    { "id": "touch_back_0_x",  "source": "touch.back.0.x",  "enabled": true, "address": "/composition/dashboard/link3", "typeTag": "f", "min": 0.0, "max": 1.0, "zeroOnRelease": true, "mode": "continuous" },
    { "id": "touch_back_0_y",  "source": "touch.back.0.y",  "enabled": true, "address": "/composition/dashboard/link4", "typeTag": "f", "min": 0.0, "max": 1.0, "invert": true, "zeroOnRelease": true, "mode": "continuous" }
