{
  "version": 1,
  "name": "TouchDesigner",
  "description": "Preset OSC de reference pour TouchDesigner (CHOP OSC In). Floats, sticks -1..1, tactile/capteurs normalises, envoi 60 Hz.",
  "target": { "ip": "192.168.1.42", "port": 9000 },
  "globalPrefix": "/vita",
  "sendRateHz": 60,
  "controls": [
    { "id": "btn_cross",    "source": "button.cross",    "enabled": true, "address": "/vita/pad/cross",    "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_circle",   "source": "button.circle",   "enabled": true, "address": "/vita/pad/circle",   "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_square",   "source": "button.square",   "enabled": true, "address": "/vita/pad/square",   "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_triangle", "source": "button.triangle", "enabled": true, "address": "/vita/pad/triangle", "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_up",       "source": "button.up",       "enabled": true, "address": "/vita/pad/up",       "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_down",     "source": "button.down",     "enabled": true, "address": "/vita/pad/down",     "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_left",     "source": "button.left",     "enabled": true, "address": "/vita/pad/left",     "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_right",    "source": "button.right",    "enabled": true, "address": "/vita/pad/right",    "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_l",        "source": "button.l",        "enabled": true, "address": "/vita/pad/l",        "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_r",        "source": "button.r",        "enabled": true, "address": "/vita/pad/r",        "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_start",    "source": "button.start",    "enabled": true, "address": "/vita/pad/start",    "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },
    { "id": "btn_select",   "source": "button.select",   "enabled": true, "address": "/vita/pad/select",   "typeTag": "f", "min": 0.0, "max": 1.0, "mode": "onChange" },

    { "id": "stick_l_x", "source": "stick.left.x",  "enabled": true, "address": "/vita/stick/lx", "typeTag": "f", "min": -1.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.0, "mode": "continuous" },
    { "id": "stick_l_y", "source": "stick.left.y",  "enabled": true, "address": "/vita/stick/ly", "typeTag": "f", "min": -1.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.0, "invert": true,  "mode": "continuous" },
    { "id": "stick_r_x", "source": "stick.right.x", "enabled": true, "address": "/vita/stick/rx", "typeTag": "f", "min": -1.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.0, "mode": "continuous" },
    { "id": "stick_r_y", "source": "stick.right.y", "enabled": true, "address": "/vita/stick/ry", "typeTag": "f", "min": -1.0, "max": 1.0, "deadzone": 0.08, "smoothing": 0.0, "invert": true,  "mode": "continuous" },

    { "id": "touch_front_0", "source": "touch.front.0", "enabled": true, "addressX": "/vita/touch/front/0/x", "addressY": "/vita/touch/front/0/y", "addressPressure": "/vita/touch/front/0/z", "typeTag": "f", "min": 0.0, "max": 1.0, "bundle": true, "mode": "continuous" },
    { "id": "touch_front_1", "source": "touch.front.1", "enabled": true, "addressX": "/vita/touch/front/1/x", "addressY": "/vita/touch/front/1/y", "addressPressure": "/vita/touch/front/1/z", "typeTag": "f", "min": 0.0, "max": 1.0, "bundle": true, "mode": "continuous" },
    { "id": "touch_back_0",  "source": "touch.back.0",  "enabled": true, "addressX": "/vita/touch/back/0/x",  "addressY": "/vita/touch/back/0/y",  "typeTag": "f", "min": 0.0, "max": 1.0, "bundle": true, "mode": "continuous" },

    { "id": "accel_x", "source": "motion.accel.x", "enabled": true, "address": "/vita/accel/x", "typeTag": "f", "min": -2.0, "max": 2.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "accel_y", "source": "motion.accel.y", "enabled": true, "address": "/vita/accel/y", "typeTag": "f", "min": -2.0, "max": 2.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "accel_z", "source": "motion.accel.z", "enabled": true, "address": "/vita/accel/z", "typeTag": "f", "min": -2.0, "max": 2.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "gyro_x",  "source": "motion.gyro.x",  "enabled": true, "address": "/vita/gyro/x",  "typeTag": "f", "min": -5.0, "max": 5.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "gyro_y",  "source": "motion.gyro.y",  "enabled": true, "address": "/vita/gyro/y",  "typeTag": "f", "min": -5.0, "max": 5.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "gyro_z",  "source": "motion.gyro.z",  "enabled": true, "address": "/vita/gyro/z",  "typeTag": "f", "min": -5.0, "max": 5.0, "smoothing": 0.1, "mode": "continuous" },
    { "id": "orient_roll",  "source": "motion.orientation.roll",  "enabled": true, "address": "/vita/orient/roll",  "typeTag": "f", "min": -1.0, "max": 1.0, "smoothing": 0.15, "mode": "continuous" },
    { "id": "orient_pitch", "source": "motion.orientation.pitch", "enabled": true, "address": "/vita/orient/pitch", "typeTag": "f", "min": -1.0, "max": 1.0, "smoothing": 0.15, "mode": "continuous" },
    { "id": "orient_yaw",   "source": "motion.orientation.yaw",   "enabled": true, "address": "/vita/orient/yaw",   "typeTag": "f", "min": -1.0, "max": 1.0, "smoothing": 0.15, "mode": "continuous" }
  ]
}
